{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "krister-website",
	"main": "worker/index.js",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": true,
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "none"
	},
	"workers_dev": true,
	"preview_urls": false
}
